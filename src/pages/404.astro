---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout title="404 – Page Not Found | Ronaldo Flores">
  <div class="min-h-screen flex flex-col items-center justify-center bg-background text-foreground">
    <h1 class="text-8xl font-bold text-primary mb-4">404</h1>
    <p class="text-xl text-muted-foreground mb-8">Oops! Page not found.</p>
    <a href="/" class="cosmic-button">Return Home</a>
  </div>
</Layout>
